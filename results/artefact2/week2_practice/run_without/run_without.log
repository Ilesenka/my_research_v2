def load(f):
    rows=[]
    for line in open(f):
        line=line.strip()
        if not line or line.startswith('wavelength'): continue
        a,b=line.split(); rows.append((float(a),float(b)))
    return rows

def find_peaks(d, thresh=0.3):
    xs=[x for x,_ in d]; ys=[y for _,y in d]
    peaks=[]
    for i in range(1,len(d)-1):
        if ys[i]>ys[i-1] and ys[i]>=ys[i+1] and ys[i]>thresh:
            peaks.append((xs[i],ys[i]))
    return peaks

def fwhm(d, xp, yp):
    xs=[x for x,_ in d]; ys=[y for _,y in d]
    half=yp/2.0
    # left crossing
    li=None
    for i in range(len(d)):
        if xs[i]>=xp: break
        if ys[i]<=half<=ys[i+1] or ys[i+1]<=half<=ys[i]:
            x0,x1=xs[i],xs[i+1]; y0,y1=ys[i],ys[i+1]
            li=x0+(half-y0)*(x1-x0)/(y1-y0); break
    ri=None
    for i in range(len(d)):
        if xs[i]<=xp: continue
        if ys[i]<=half<=ys[i+1] or ys[i+1]<=half<=ys[i]:
            x0,x1=xs[i],xs[i+1]; y0,y1=ys[i],ys[i+1]
            ri=x0+(half-y0)*(x1-x0)/(y1-y0); break
    return (ri-li) if (li and ri) else None

for f in ['spectrum_01','spectrum_02','spectrum_03','spectrum_04']:
    d=load(f'data/{f}.txt')
    for xp,yp in find_peaks(d):
        print(f, 'peak', round(xp,2), 'h=%.3f'%yp, 'fwhm=%.2f'%fwhm(d,xp,yp))
