    command: cd /home/olesya/shad/agent_instance/week2_practice/run_with && .venv/bin/python -c "
import numpy as np
for f in ['spectrum_01','spectrum_02','spectrum_03','spectrum_04']:
    d=np.loadtxt(f'data/{f}.txt',skiprows=1)
    w,i=d[:,0],d[:,1]
    print('===',f)
    # linear fit on whole range
    A=np.vstack([w,np.ones_like(w)]).T
    coef,res,_,_=np.linalg.lstsq(A,i,rcond=None)
    fit=A@coef
    resid=i-fit
    print('  lin fit slope,intercept', round(coef[0],5), round(coef[1],4))
    print('  resid std', round(np.std(resid),4), 'max|resid|', round(np.max(np.abs(resid)),3))
"

